# Liquid Zimbabwe 4G Network Optimizer - Lightweight Container
FROM python:3.11-alpine

# Set working directory
WORKDIR /app

# Install system dependencies for Liquid Zimbabwe integration
RUN apk add --no-cache \
    gcc \
    musl-dev \
    && rm -rf /var/cache/apk/*

# Copy requirements first for better layer caching
COPY requirements-lz-minimal.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements-lz-minimal.txt

# Copy LZ-specific application files
COPY liquid-4g-core/agents/*.py ./
COPY liquid-4g-core/agents_lz_test.py ./
COPY liquid-4g-core/lz_ui_test.py ./
COPY liquid-4g-core/lz_startup_with_ui.py ./
COPY liquid-4g-core/config/config-lz.yaml ./config-lz.yaml
COPY liquid-4g-core/data/ ./data/

# Create non-root user for security
RUN adduser -D -s /bin/sh lzuser
RUN chown -R lzuser:lzuser /app
USER lzuser

# Expose port for LZ monitoring interface
EXPOSE 8501

# Health check for container monitoring (commented out for testing)
# HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
#     CMD curl -f http://localhost:8501/health || exit 1

# Default command to start LZ system with UI
CMD ["python", "lz_startup_with_ui.py"]