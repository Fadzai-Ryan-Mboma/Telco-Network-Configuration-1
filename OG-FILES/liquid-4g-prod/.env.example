# Liquid Zimbabwe 4G Optimizer - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control!

# ============================================
# ENVIRONMENT
# ============================================
ENV=development  # development | production | testing

# ============================================
# HUAWEI API CONFIGURATION
# ============================================
HUAWEI_API_URL=https://your-api-url:31127
HUAWEI_USERNAME=your_username
HUAWEI_PASSWORD=  # Leave empty, use secrets manager in production
HUAWEI_SSL_VERIFY=true

# ============================================
# LLM CONFIGURATION
# ============================================
# Primary LLM Provider: openai | anthropic | local
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=  # Your OpenAI API key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.0

# Anthropic Configuration (if using Claude)
ANTHROPIC_API_KEY=  # Your Anthropic API key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Local LLM Configuration (if using Ollama/vLLM)
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3:8b

# LLM Settings
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4000

# ============================================
# DATABASE
# ============================================
DB_PATH=data/database/liquid4g.db
DB_POOL_SIZE=5
DB_TIMEOUT=30
DB_ENABLE_WAL=true

# ============================================
# REDIS CACHE (Optional)
# ============================================
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json  # json | text
LOG_FILE=data/logs/liquid4g.log

# ============================================
# API SERVER
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ============================================
# STREAMLIT UI
# ============================================
STREAMLIT_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# ============================================
# MONITORING
# ============================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
METRICS_ENABLED=true

# ============================================
# AGENT CONFIGURATION
# ============================================
# Circuit Breaker
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60

# Agent Settings
AGENT_LLM_ENABLED=true
AGENT_FALLBACK_ENABLED=true
AGENT_TIMEOUT=120

# ============================================
# SECURITY
# ============================================
# JWT for API authentication
JWT_SECRET_KEY=  # Generate with: openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=30

# ============================================
# DOCKER / DEPLOYMENT
# ============================================
DOCKER_DEPLOYMENT=false
TZ=Africa/Harare

# ============================================
# SECRETS MANAGEMENT
# ============================================
# For production, use:
# - Docker secrets: /run/secrets/secret_name
# - HashiCorp Vault: VAULT_ADDR, VAULT_TOKEN
# - AWS Secrets Manager: AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
SECRETS_BACKEND=environment  # environment | docker | vault | aws
