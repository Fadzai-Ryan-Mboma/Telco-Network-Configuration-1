# ===========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# Liquid Zimbabwe 4G Optimization Platform
# ===========================================

# Production API Configuration
LZ_API_URL=https://41.174.191.214:31127
LZ_API_USERNAME=cassava.ai
LZ_API_PASSWORD=#Pass123#
LZ_ENVIRONMENT=production

# Security Settings
SSL_VERIFY=true
API_TIMEOUT=30
MAX_RETRIES=3

# Database Configuration
DATABASE_PATH=/app/data/historical_db
BACKUP_ENABLED=true
BACKUP_INTERVAL=daily

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_RETENTION_DAYS=30

# System Configuration
MONITORING_INTERVAL=300
ALERT_THRESHOLD_HIGH=80
ALERT_THRESHOLD_CRITICAL=95

# Performance Settings
CACHE_ENABLED=true
CACHE_TTL=300
MAX_CONCURRENT_REQUESTS=10

# UI Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_THEME=light

# Container-specific settings
CONTAINER_TIMEZONE=Africa/Harare
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_CPU_LIMIT=1.0