# Liquid Zimbabwe 4G Network Optimizer - Environment Variables Template
# Created: 2025-10-30
# Instructions:
#   1. Copy this file to .env
#   2. Replace placeholder values with actual credentials
#   3. NEVER commit .env to version control

# ============================================================================
# NVIDIA AI API Credentials
# ============================================================================
# Get your API key from: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# ============================================================================
# Huawei iMaster MAE API Credentials
# ============================================================================
# Production Huawei iMaster MAE-O API endpoint
HUAWEI_API_URL=https://41.174.191.214:31127
HUAWEI_USERNAME=your_username_here
HUAWEI_PASSWORD=your_password_here

# ============================================================================
# Optional: Database Configuration
# ============================================================================
# If you want to override the default database path
# DATABASE_PATH=data/lz_network.db

# ============================================================================
# Optional: Logging Configuration
# ============================================================================
# Override default logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# ============================================================================
# Optional: System Configuration
# ============================================================================
# Enable debug mode (verbose logging, no actual API calls)
# DEBUG_MODE=false

# Enable test mode (use mock data)
# TEST_MODE=false

# Enable offline mode (only use historical data, no API calls)
# OFFLINE_MODE=false

# ============================================================================
# Optional: UI Configuration
# ============================================================================
# Streamlit UI port (default: 8501)
# UI_PORT=8501

# ============================================================================
# Security Notes
# ============================================================================
# - This file contains sensitive credentials
# - .env is already in .gitignore
# - For production deployment, use secure secret management (e.g., AWS Secrets Manager, HashiCorp Vault)
# - Rotate credentials regularly
# - Use least-privilege access for Huawei API user
